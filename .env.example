# ── TMDB (required for movie data, images and reviews) ─────────────────────
# Get a free key at https://www.themoviedb.org/settings/api
# Either the v4 "API Read Access Token" (preferred) or the v3 "API Key" works.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# ── Extra free sources (optional — each switches on when its key is set) ───
# OMDb: IMDb / Rotten Tomatoes / Metacritic scores + awards. Free key (1,000/day):
#   https://www.omdbapi.com/apikey.aspx   — data is CC BY-NC 4.0 (non-commercial)
OMDB_API_KEY=
# Trakt: live "watching now" trending + audience ratings. Create an app at
#   https://trakt.tv/oauth/applications  and paste its Client ID
TRAKT_CLIENT_ID=
# Wikidata (awards, Wikipedia links) needs no key.

# ── Supabase (optional: accounts, cloud-synced watchlist, admin, analytics) ─
# Without these, CineMood still works: your watchlist/watched list is kept in this browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser. Used by sync jobs and admin.
SUPABASE_SERVICE_ROLE_KEY=

# ── Local AI via Ollama (optional: nuanced mood scoring + natural-language search) ─
# All AI runs locally. Without Ollama, a deterministic rule-based engine is used.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Default region for watch providers / regional trending (ISO 3166-1)
DEFAULT_REGION=CA
