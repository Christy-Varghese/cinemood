/**
 * Generates supabase/migrations/0002_seed.sql from the canonical taxonomy
 * and reference data, so the database and the app never drift apart.
 *   node --experimental-strip-types scripts/generate-seed.mts
 */
import { writeFileSync } from "node:fs";
import { MOOD_SEED } from "../lib/moods/taxonomy.ts";
import { GENRES, LANGUAGES } from "../lib/reference.ts";
import { DEFAULT_WEIGHTS } from "../lib/recommendations/weights.ts";

const q = (s: string | null | undefined) => (s == null ? "null" : `'${s.replace(/'/g, "''")}'`);

const moods = MOOD_SEED.map(
  (m) => `  (${q(m.name)}, ${q(m.slug)}, ${q(m.icon)}, ${q(m.description)}, ${q(m.tagline)}, ${q(m.accent)}, ${m.featured}, ${m.isActive}, ${m.sortOrder})`,
).join(",\n");
const genres = GENRES.map((g) => `  (${g.id}, ${q(g.name)}, ${q(g.slug)})`).join(",\n");
const langs = LANGUAGES.map((l) => `  (${q(l.code)}, ${q(l.name)}, ${q(l.nativeName)}, ${q(l.region)})`).join(",\n");

const sql = `-- Generated by scripts/generate-seed.mts — do not edit by hand.

insert into public.moods (name, slug, icon, description, tagline, accent, featured, is_active, sort_order) values
${moods}
on conflict (slug) do update set name = excluded.name, icon = excluded.icon, description = excluded.description,
  tagline = excluded.tagline, accent = excluded.accent, featured = excluded.featured, sort_order = excluded.sort_order;

insert into public.genres (tmdb_id, name, slug) values
${genres}
on conflict (tmdb_id) do update set name = excluded.name, slug = excluded.slug;

insert into public.languages (code, name, native_name, region) values
${langs}
on conflict (code) do update set name = excluded.name, native_name = excluded.native_name, region = excluded.region;

insert into public.recommendation_configs (version, weights, note, is_active)
values (1, '${JSON.stringify(DEFAULT_WEIGHTS)}'::jsonb, 'Default weights from the master spec', true)
on conflict (version) do nothing;

insert into public.feature_flags (key, enabled, description) values
  ('AI_SEARCH', true, 'Use the local Ollama model to interpret natural-language searches'),
  ('PERSONALIZATION', true, 'Blend each user''s taste into rankings'),
  ('STREAMING_AVAILABILITY', true, 'Show licensed where-to-watch data'),
  ('SURPRISE_ME', true, 'Enable the Surprise Me experience'),
  ('MOOD_ENGINE_V2', false, 'Experimental mood engine')
on conflict (key) do nothing;
`;

writeFileSync(new URL("../supabase/migrations/0002_seed.sql", import.meta.url), sql);
console.log("wrote supabase/migrations/0002_seed.sql");
